@model IList<PersonalTaskManager.Web.Models.Activity.ActivityLogItemViewModel>

<ul class="list-group list-group-flush activity-timeline" id="activityTimeline">
    @if (Model == null || Model.Count == 0)
    {
        <li class="list-group-item text-muted small activity-empty-msg">Chưa có hoạt động nào.</li>
    }
    else
    {
        foreach (var item in Model)
        {
            <li class="list-group-item activity-item">
                <div class="d-flex justify-content-between gap-2">
                    <span class="activity-message">@item.Message</span>
                    <time class="text-muted small text-nowrap activity-time" datetime="@item.CreatedAt.ToString("o")">@item.TimeLabel</time>
                </div>
            </li>
        }
    }
</ul>
