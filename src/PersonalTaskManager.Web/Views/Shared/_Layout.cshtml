<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Personal Task Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="@Url.Action("Index", "Home")">Task Manager</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a class="nav-link" href="@Url.Action("About", "Home")">DB Status</a>
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
    <footer class="border-top py-3 text-center text-muted">
        <small>Personal Task Manager &copy; @DateTime.Now.Year — Phase 1</small>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
