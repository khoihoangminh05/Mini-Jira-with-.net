@model PersonalTaskManager.Web.Models.Kanban.KanbanViewModel
@{
    ViewBag.Title = "Kanban — " + Model.ProjectName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Project")">Dự án</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Task", new { projectId = Model.ProjectId })">@Model.ProjectName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Kanban</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.ProjectName</h1>
        <p class="text-muted mb-0">Bảng Kanban — kéo thả sẽ có ở Phase 8</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Task", new { projectId = Model.ProjectId })">Danh sách</a>
        <a class="btn btn-primary" href="@Url.Action("Create", "Task", new { projectId = Model.ProjectId })">+ Tạo task</a>
    </div>
</div>

<div class="row g-3 kanban-board">
    <div class="col-lg-4">
        <div class="kanban-column kanban-column-todo h-100">
            <div class="kanban-column-header">
                <h2 class="h6 mb-0">Cần làm</h2>
                <span class="badge bg-secondary">@Model.ToDo.Count</span>
            </div>
            <div class="kanban-column-body">
                @if (Model.ToDo.Count == 0)
                {
                    <p class="text-muted small text-center py-3 mb-0">Không có task</p>
                }
                else
                {
                    foreach (var task in Model.ToDo)
                    {
                        @Html.Partial("_TaskCard", task)
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="kanban-column kanban-column-progress h-100">
            <div class="kanban-column-header">
                <h2 class="h6 mb-0">Đang làm</h2>
                <span class="badge bg-primary">@Model.InProgress.Count</span>
            </div>
            <div class="kanban-column-body">
                @if (Model.InProgress.Count == 0)
                {
                    <p class="text-muted small text-center py-3 mb-0">Không có task</p>
                }
                else
                {
                    foreach (var task in Model.InProgress)
                    {
                        @Html.Partial("_TaskCard", task)
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="kanban-column kanban-column-done h-100">
            <div class="kanban-column-header">
                <h2 class="h6 mb-0">Hoàn thành</h2>
                <span class="badge bg-success">@Model.Done.Count</span>
            </div>
            <div class="kanban-column-body">
                @if (Model.Done.Count == 0)
                {
                    <p class="text-muted small text-center py-3 mb-0">Không có task</p>
                }
                else
                {
                    foreach (var task in Model.Done)
                    {
                        @Html.Partial("_TaskCard", task)
                    }
                }
            </div>
        </div>
    </div>
</div>

<a class="btn btn-outline-secondary mt-4" href="@Url.Action("Index", "Project")">← Quay lại dự án</a>
